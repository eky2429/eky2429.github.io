<article class="archive-project-card">
  <h3><%=project[:name] %></h3>
  <div class="badges">
    <% project[:badges].each do |badge| %>
      <span><%= badge %></span>
    <% end %>
  </div>
  <p>
    <%=project[:text] %>
  </p>

  <%if project[:slug] %>
    <a href=<%= "/projects/" +project[:slug] %>>View Project</a>
  <% else %>
    <p>View Project (TBD)</p>
  <% end %>
</article>