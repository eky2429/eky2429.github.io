<div class="row g-3">
  <% image = images[0] %>
  <div class="col-12">
    <figure class="text-center">
      <img src="<%= image[:src] %>"
           alt="<%= image[:alt] %>"
           class="project-image-single img-fluid rounded d-block mx-auto">

      <figcaption>
        <%= image[:alt] %>
      </figcaption>
    </figure>
  </div>
</div>